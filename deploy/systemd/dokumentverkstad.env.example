# Optional environment for systemd services.
# Copy to /etc/dokumentverkstad/dokumentverkstad.env and protect it with:
#   sudo chown root:dokumentverkstad /etc/dokumentverkstad/dokumentverkstad.env
#   sudo chmod 640 /etc/dokumentverkstad/dokumentverkstad.env

# Keep secrets out of unit files and out of git.
# OPENAI_API_KEY=

# Optional overrides. The checked-in unit files already pass --config explicitly.
# DOKUMENTVERKSTAD_CONFIG=/opt/dokumentverkstad/dokumentverkstad.toml
# DOKUMENTVERKSTAD_ARCHIVE_ROOT=/var/lib/dokumentverkstad/archive
# DOKUMENTVERKSTAD_RUNTIME_ROOT=/var/lib/dokumentverkstad/runtime
# DOKUMENTVERKSTAD_INGEST_SOURCE=/var/lib/dokumentverkstad/ingest
# DOKUMENTVERKSTAD_HOST=127.0.0.1
# DOKUMENTVERKSTAD_PORT=8000
